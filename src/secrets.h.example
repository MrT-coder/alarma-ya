#pragma once

// ---------------------------------------------------------------------------
// Local credentials. Fill these in with real values.
// Keep this file OUT of version control - copy secrets.h.example instead.
// ---------------------------------------------------------------------------

// Home WiFi - one or more access points.
// WiFiMulti scans at connect time and joins the strongest network it can
// actually see from this list, so the same firmware can boot in more than one
// location without a reflash. It picks once, on connect: there is no roaming,
// so a board already associated stays put until the link drops.
//
// Slots 2 and 3 are optional. Uncomment a pair to register it; leave it
// commented and it is simply not compiled in.
//
// The ESP32 radio is 2.4 GHz ONLY. A 5 GHz SSID will never connect, no matter
// how correct the password is. If the router broadcasts both bands under the
// same name, the 2.4 GHz band still has to be enabled.
#define WIFI_AP1_SSID "example-ssid"
#define WIFI_AP1_PASS "example-password"

// #define WIFI_AP2_SSID "second-network"
// #define WIFI_AP2_PASS "second-password"

// #define WIFI_AP3_SSID "third-network"
// #define WIFI_AP3_PASS "third-password"

// HiveMQ Cloud cluster.
// Every HiveMQ Cloud account gets its own hostname, so this is NOT a shared
// constant: yours will not look like anyone else's. Find it in the HiveMQ
// console under Cluster Details > URL. Paste only the hostname - no scheme,
// no port, no trailing slash.
#define MQTT_HOST "your-cluster-id.s1.eu.hivemq.cloud"

// HiveMQ Cloud - subscribe-only credential for the device.
// Create it under Access Management > Credentials and give it SUBSCRIBE
// permission on alarma-ya/comando and nothing else. The device never
// publishes, so a publish permission here would only widen the blast radius
// if the board is ever read out.
#define MQTT_USER "alarma-ya"
#define MQTT_PASS "example-password"
